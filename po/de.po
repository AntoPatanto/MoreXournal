#: ../src/core/control/XournalMain.cpp:681
msgid ""
"Export without background\n"
"                                       The exported file has transparent or "
"white background,\n"
"                                       depending on what its format "
"supports\n"
msgstr ""
"Exportiere ohne Hintergrund\n"
"                                 Die exportierte Datei hat einen "
"transparenten oder weißen Hintergrund,\n"
"                                 abhängig davon, was das jeweilige "
"Dateiformat unterstützt\n"

#: ../src/core/control/XournalMain.cpp:686
msgid ""
"Export without ruling\n"
"                                       The exported file has no paper "
"ruling\n"
msgstr ""
"Exportiere ohne Lineatur\n"
"                                 Die exportierte Datei hat keine Lineatur\n"

#: ../src/core/control/XournalMain.cpp:691
msgid ""
"Export layers progressively\n"
"                                       In PDF export, Render layers "
"progressively one by one.\n"
"                                       This results in N export pages per "
"page with N layers,\n"
"                                       building up the layer stack "
"progressively.\n"
"                                       The resulting PDF file can be used "
"for a presentation.\n"
msgstr ""
"Ebenen schrittweise exportieren\n"
"                                 Beim Export als PDF werden die Ebenen "
"nacheinander auf einzelne Seiten abgebildet.\n"
"                                 Dadurch werden für eine Seite mit N Ebenen "
"N Exportseiten erstellt,\n"
"                                 was den Ebenenstapel Schritt für Schritt "
"aufbaut.\n"
"                                 Die entstehende PDF-Datei kann als "
"Präsentation benutzt werden.\n"

#: ../src/core/control/XournalMain.cpp:700
msgid ""
"Only export the pages specified by RANGE (e.g. \"2-3,5,7-\")\n"
"                                       No effect without -p/--create-pdf or "
"-i/--create-img"
msgstr ""
"Exportiere nur die durch den Bereich angegebenen Seiten (z.B. \"2-3,5,7-\")\n"
"                                 Keine Auswirkung ohne -p/--create-pdf oder "
"-i/--create-img"

#: ../src/core/control/XournalMain.cpp:705
msgid ""
"Only export the layers specified by RANGE (e.g. \"2-3,5,7-\")\n"
"                                       No effect without -p/--create-pdf or "
"-i/--create-img"
msgstr ""
"Exportiere nur die durch den Bereich angegebenen Ebenen (z.B. \"2-3,5,7-\")\n"
"                                 Keine Auswirkung ohne -p/--create-pdf oder "
"-i/--create-img"

#: ../src/core/control/XournalMain.cpp:709
