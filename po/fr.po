#: ../src/core/gui/dialog/SettingsDialog.cpp:154
msgid ""
"%{name}\tFilename of the PDF background (if any)\n"
"%{file}\t\tSaved filename of the document\n"
"%a\t\tAbbreviated weekday name (e.g. Thu)\n"
"%A\t\tFull weekday name (e.g. Thursday)\n"
"%b\t\tAbbreviated month name (e.g. Aug)\n"
"%B\t\tFull month name (e.g. August)\n"
"%c\t\tDate and time representation\n"
"%d\t\tDay of the month (01-31)\n"
"%F\t\tDate representation (e.g. 2026-11-28)\n"
"%H\t\tHour in 24h format (00-23)\n"
"%I\t\tHour in 12h format (01-12)\n"
"%j\t\tDay of the year (001-366)\n"
"%m\t\tMonth as a decimal number (01-12)\n"
"%M\t\tMinute (00-59)\n"
"%p\t\tAM or PM designation\n"
"%S\t\tSecond (00-61)\n"
"%U\t\tWeek number, Sunday first (00-53)\n"
"%w\t\tWeekday as decimal, Sunday = 0 (0-6)\n"
"%W\t\tWeek number, Monday first (00-53)\n"
"%x\t\tLocale date representation\n"
"%X\t\tLocale time representation\n"
"%y\t\tYear, last two digits (00-99)\n"
"%Y\t\tYear (e.g. 2026)\n"
"%Z\t\tTimezone name or abbreviation\n"
"%%\t\tLiteral %\n"
"\n"
"Illegal characters are replaced with \"_\"."
msgstr ""
"%{name}\tNom du fichier PDF d'arrière-plan (le cas échéant)\n"
"%{file}\t\tNom du fichier enregistré du document\n"
"%a\t\tNom abrégé du jour de la semaine (p. ex. jeu.)\n"
"%A\t\tNom complet du jour de la semaine (p. ex. jeudi)\n"
"%b\t\tNom abrégé du mois (p. ex. août)\n"
"%B\t\tNom complet du mois (p. ex. août)\n"
"%c\t\tReprésentation de la date et de l'heure\n"
"%d\t\tJour du mois (01-31)\n"
"%F\t\tReprésentation de la date (p. ex. 2026-11-28)\n"
"%H\t\tHeure au format 24 h (00-23)\n"
"%I\t\tHeure au format 12 h (01-12)\n"
"%j\t\tJour de l'année (001-366)\n"
"%m\t\tMois sous forme décimale (01-12)\n"
"%M\t\tMinute (00-59)\n"
"%p\t\tDésignation AM ou PM\n"
"%S\t\tSeconde (00-61)\n"
"%U\t\tNuméro de semaine, dimanche en premier (00-53)\n"
"%w\t\tJour de la semaine en décimal, dimanche = 0 (0-6)\n"
"%W\t\tNuméro de semaine, lundi en premier (00-53)\n"
"%x\t\tReprésentation locale de la date\n"
"%X\t\tReprésentation locale de l'heure\n"
"%y\t\tAnnée, deux derniers chiffres (00-99)\n"
"%Y\t\tAnnée (p. ex. 2026)\n"
"%Z\t\tNom ou abréviation du fuseau horaire\n"
"%%\t\tCaractère littéral %\n"
"\n"
"Les caractères interdits sont remplacés par \"_\"."

