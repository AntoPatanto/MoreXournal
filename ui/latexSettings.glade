<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkBox" id="latexSettingsPanel">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <property name="orientation">vertical</property>
    <property name="spacing">20</property>

    <!-- Section 1: LaTeX -->
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="xalign">0</property>
            <property name="label" translatable="yes">LaTeX</property>
            <style><class name="mx-prefs-section-title"/></style>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">vertical</property>
            <style><class name="mx-prefs-card"/></style>

            <!-- Generation command -->
            <child>
              <object class="GtkBox" id="rowLatexGenCmd">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">16</property>
                <style><class name="mx-prefs-row"/></style>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="hexpand">True</property>
                    <property name="xalign">0</property>
                    <property name="valign">center</property>
                    <property name="label" translatable="yes">Generation command</property>
                    <style><class name="mx-prefs-row-title"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="spacing">6</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkEntry" id="latexSettingsGenCmd">
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="width-chars">26</property>
                        <property name="input-purpose">terminal</property>
                        <style><class name="mx-prefs-mono"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="latexSettingsTestBtn">
                        <property name="label" translatable="yes">Test</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="receives-default">True</property>
                        <property name="tooltip-text" translatable="yes">Test if the current configuration is valid by running the LaTeX generation command on the global template file with a test formula.</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <child><object class="GtkSeparator"><property name="visible">True</property><style><class name="mx-prefs-row-sep"/></style></object></child>

            <!-- Check LaTeX is installed before running -->
            <child>
              <object class="GtkBox" id="rowLatexCheck">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">16</property>
                <style><class name="mx-prefs-row"/></style>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="hexpand">True</property>
                    <property name="xalign">0</property>
                    <property name="valign">center</property>
                    <property name="wrap">True</property>
                    <property name="label" translatable="yes">Check LaTeX is installed before running</property>
                    <property name="tooltip-text" translatable="yes">If enabled, check that required LaTeX packages are installed and that the LaTeX commands are available before running the LaTeX tool.</property>
                    <style><class name="mx-prefs-row-title"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkSwitch" id="latexSettingsRunCheck">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>

            <child><object class="GtkSeparator"><property name="visible">True</property><style><class name="mx-prefs-row-sep"/></style></object></child>

            <!-- Template file -->
            <child>
              <object class="GtkBox" id="rowLatexTemplate">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">16</property>
                <style><class name="mx-prefs-row"/></style>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <property name="hexpand">True</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="xalign">0</property>
                        <property name="label" translatable="yes">Template file</property>
                        <style><class name="mx-prefs-row-title"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Substitutes %%XPP_TOOL_INPUT%%, %%XPP_TEXT_COLOR%%, and %%XPP_VARNAME%%.</property>
                        <style><class name="mx-prefs-row-sub"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="latexSettingsTemplateFile">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>

            <child><object class="GtkSeparator"><property name="visible">True</property><style><class name="mx-prefs-row-sep"/></style></object></child>

            <!-- Default formula -->
            <child>
              <object class="GtkBox" id="rowLatexDefault">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">16</property>
                <style><class name="mx-prefs-row"/></style>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="hexpand">True</property>
                    <property name="xalign">0</property>
                    <property name="valign">center</property>
                    <property name="label" translatable="yes">Default formula</property>
                    <style><class name="mx-prefs-row-title"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="latexDefaultEntry">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="valign">center</property>
                    <property name="width-chars">24</property>
                    <style><class name="mx-prefs-mono"/></style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Section 2: Formula editor -->
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkLabel" id="lbSourceViewHeader">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="xalign">0</property>
            <property name="label" translatable="yes">Formula editor</property>
            <style><class name="mx-prefs-section-title"/></style>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">vertical</property>
            <style><class name="mx-prefs-card"/></style>

            <child>
              <object class="GtkBox" id="bxGtkSourceviewSettings">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="orientation">vertical</property>

                <!-- Editor theme -->
                <child>
                  <object class="GtkBox" id="rowLatexTheme">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="spacing">16</property>
                    <style><class name="mx-prefs-row"/></style>
                    <child>
                      <object class="GtkLabel" id="lbSourceviewSettingsDescription">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="hexpand">True</property>
                        <property name="xalign">0</property>
                        <property name="valign">center</property>
                        <property name="wrap">True</property>
                        <style><class name="mx-prefs-row-title"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="bxThemeSelectionContainer">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>

                <child><object class="GtkSeparator"><property name="visible">True</property><style><class name="mx-prefs-row-sep"/></style></object></child>

                <!-- Line numbers -->
                <child>
                  <object class="GtkBox" id="rowLatexLines">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="spacing">16</property>
                    <style><class name="mx-prefs-row"/></style>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="hexpand">True</property>
                        <property name="xalign">0</property>
                        <property name="valign">center</property>
                        <property name="label" translatable="yes">Line numbers</property>
                        <style><class name="mx-prefs-row-title"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSwitch" id="cbShowLineNumbers">
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>

                <child><object class="GtkSeparator"><property name="visible">True</property><style><class name="mx-prefs-row-sep"/></style></object></child>

                <!-- Syntax highlighting -->
                <child>
                  <object class="GtkBox" id="rowLatexHighlight">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="spacing">16</property>
                    <style><class name="mx-prefs-row"/></style>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="hexpand">True</property>
                        <property name="xalign">0</property>
                        <property name="valign">center</property>
                        <property name="label" translatable="yes">Syntax highlighting</property>
                        <style><class name="mx-prefs-row-title"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSwitch" id="cbSyntaxHighlight">
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>

                <child><object class="GtkSeparator"><property name="visible">True</property><style><class name="mx-prefs-row-sep"/></style></object></child>

                <!-- Auto-indent -->
                <child>
                  <object class="GtkBox" id="rowLatexIndent">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="spacing">16</property>
                    <style><class name="mx-prefs-row"/></style>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="hexpand">True</property>
                        <property name="xalign">0</property>
                        <property name="valign">center</property>
                        <property name="label" translatable="yes">Auto-indent</property>
                        <style><class name="mx-prefs-row-title"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSwitch" id="cbAutoIndent">
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <child><object class="GtkSeparator"><property name="visible">True</property><style><class name="mx-prefs-row-sep"/></style></object></child>

            <!-- Wrap long lines -->
            <child>
              <object class="GtkBox" id="rowLatexWrap">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">16</property>
                <style><class name="mx-prefs-row"/></style>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="hexpand">True</property>
                    <property name="xalign">0</property>
                    <property name="valign">center</property>
                    <property name="label" translatable="yes">Wrap long lines</property>
                    <style><class name="mx-prefs-row-title"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkSwitch" id="cbWordWrap">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>

            <child><object class="GtkSeparator"><property name="visible">True</property><style><class name="mx-prefs-row-sep"/></style></object></child>

            <!-- Use system font -->
            <child>
              <object class="GtkBox" id="rowLatexSystemFont">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">16</property>
                <style><class name="mx-prefs-row"/></style>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="hexpand">True</property>
                    <property name="xalign">0</property>
                    <property name="valign">center</property>
                    <property name="label" translatable="yes">Use system font</property>
                    <style><class name="mx-prefs-row-title"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkSwitch" id="cbUseSystemFont">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>

            <child><object class="GtkSeparator"><property name="visible">True</property><style><class name="mx-prefs-row-sep"/></style></object></child>

            <!-- Font -->
            <child>
              <object class="GtkBox" id="boxCustomFontOptions">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">16</property>
                <style><class name="mx-prefs-row"/></style>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <property name="hexpand">True</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkLabel" id="lbFontLabel">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="xalign">0</property>
                        <property name="label" translatable="yes">Font</property>
                        <style><class name="mx-prefs-row-title"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lbFontDepHint">
                        <property name="visible">False</property>
                        <property name="no-show-all">True</property>
                        <property name="can-focus">False</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Available when “Use system font” is off.</property>
                        <style><class name="mx-prefs-row-sub"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkFontButton" id="selBtnEditorFont">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="receives-default">True</property>
                    <property name="valign">center</property>
                    <property name="font">Sans 12</property>
                    <property name="preview-text"/>
                    <property name="title" translatable="yes">Pick the Editor's Font</property>
                    <property name="show-style">False</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Section 3: External LaTeX editor -->
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="xalign">0</property>
            <property name="label" translatable="yes">External LaTeX editor</property>
            <style><class name="mx-prefs-section-title"/></style>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">vertical</property>
            <style><class name="mx-prefs-card"/></style>

            <!-- Edit formulas in another program -->
            <child>
              <object class="GtkBox" id="rowLatexExtOn">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">16</property>
                <style><class name="mx-prefs-row"/></style>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="hexpand">True</property>
                    <property name="xalign">0</property>
                    <property name="valign">center</property>
                    <property name="wrap">True</property>
                    <property name="label" translatable="yes">Edit formulas in another program</property>
                    <style><class name="mx-prefs-row-title"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkSwitch" id="cbUseExternalEditor">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>

            <child><object class="GtkSeparator"><property name="visible">True</property><style><class name="mx-prefs-row-sep"/></style></object></child>

            <!-- Editor command -->
            <child>
              <object class="GtkBox" id="rowLatexExtCmd">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">16</property>
                <style><class name="mx-prefs-row"/></style>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <property name="hexpand">True</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="xalign">0</property>
                        <property name="label" translatable="yes">Editor command</property>
                        <style><class name="mx-prefs-row-title"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lbExtCmdDepHint">
                        <property name="visible">False</property>
                        <property name="no-show-all">True</property>
                        <property name="can-focus">False</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Turn on “Edit formulas in another program” to change this.</property>
                        <style><class name="mx-prefs-row-sub"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="latexExternalEditorCmd">
                    <property name="name">entryExternalEditorCmd</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="valign">center</property>
                    <property name="width-chars">22</property>
                    <style><class name="mx-prefs-mono"/></style>
                  </object>
                </child>
              </object>
            </child>

            <child><object class="GtkSeparator"><property name="visible">True</property><style><class name="mx-prefs-row-sep"/></style></object></child>

            <!-- Temporary file extension -->
            <child>
              <object class="GtkBox" id="rowLatexExtExt">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">16</property>
                <style><class name="mx-prefs-row"/></style>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <property name="hexpand">True</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="xalign">0</property>
                        <property name="label" translatable="yes">Temporary file extension</property>
                        <style><class name="mx-prefs-row-title"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lbExtExtDepHint">
                        <property name="visible">False</property>
                        <property name="no-show-all">True</property>
                        <property name="can-focus">False</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Turn on “Edit formulas in another program” to change this.</property>
                        <style><class name="mx-prefs-row-sub"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="latexTemporaryFileExt">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="valign">center</property>
                    <property name="width-chars">14</property>
                    <property name="placeholder-text">tex</property>
                    <style><class name="mx-prefs-mono"/></style>
                  </object>
                </child>
              </object>
            </child>

            <child><object class="GtkSeparator"><property name="visible">True</property><style><class name="mx-prefs-row-sep"/></style></object></child>

            <!-- Insert the formula when the editor closes -->
            <child>
              <object class="GtkBox" id="rowLatexExtConfirm">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">16</property>
                <style><class name="mx-prefs-row"/></style>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <property name="hexpand">True</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Insert the formula when the editor closes</property>
                        <style><class name="mx-prefs-row-title"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lbExtConfirmDepHint">
                        <property name="visible">False</property>
                        <property name="no-show-all">True</property>
                        <property name="can-focus">False</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Turn on “Edit formulas in another program” to change this.</property>
                        <style><class name="mx-prefs-row-sub"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkSwitch" id="cbExternalEditorAutoConfirm">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
